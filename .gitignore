venv/
__pycache__/
*.pyc

# Artefatos de build do executavel/instalador (gerados por build_scripts + PyInstaller + Inno Setup)
dist/
dist_native/
build/
Output/

# FFmpeg (build "release essentials", ~90MB extraido) usado pelo stream
# Wi-Fi da GoPro - baixado a parte (build_scripts/diagnose_gopro_stream.py
# ou gopro_controller.py explicam onde/como), nao versionar binario grande
ffmpeg-*/

# Fotos/videos capturados pelo app (e os sidecars de localizacao) - inclui
# os brutos da GoPro (capturas/raw/) e os finais processados (capturas/final/)
capturas/*.jpg
capturas/*.mp4
capturas/*.location.txt
capturas/raw/
capturas/final/

# Eventos (nomes/textos/logos reais do operador) e os PNGs enviados por
# evento - dado operacional da instalacao, nao template versionavel
events.json
event_assets/

# Templates de tirinha criados pelo operador e as imagens usadas neles
strip_templates/
strip_assets/

# Chave de licenca ativada + id da maquina - identifica essa instalacao
# especifica, nunca versionar
license.json

# Log do executavel (erros no cliente) e ffmpeg copiado pelo build_products.ps1
app.log
ffmpeg-bundled/
